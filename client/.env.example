# Client environment (copy to client/.env). Only VITE_* variables are exposed to the browser.

# Base URL of the API. Leave empty in development: Vite proxies /api to the server.
VITE_API_URL=

# Public contact address shown in the footer.
VITE_CONTACT_EMAIL=hello@ai101talents.com

# Dev server only (not exposed to the browser)
CLIENT_PORT=5173
VITE_DEV_API_PROXY=http://localhost:4000
