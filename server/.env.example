# Server environment. Copy to server/.env. Every variable is optional in development.

NODE_ENV=development
PORT=4000

# Origin of the React app. CORS only allows this origin (with credentials), and email links point here.
CLIENT_URL=http://localhost:5173

# ---- Database -------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas in production). Required in production.
# Leave empty in development to use an embedded MongoDB stored in server/.data/mongo.
MONGODB_URI=

# ---- Auth -----------------------------------------------------------------
# Secret used to sign session JWTs. Required in production (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If empty in development, a random secret is used and sessions reset on restart.
JWT_SECRET=
JWT_EXPIRES_IN_DAYS=7
COOKIE_NAME=ai101_session
# lax works when the client and API share a site (e.g. app.example.com + api.example.com, or the Vite proxy).
# Use none only if they are on different sites (requires HTTPS).
COOKIE_SAMESITE=lax

# ---- Email (Nodemailer / SMTP) --------------------------------------------
# Required in production. If SMTP_HOST is empty in development, emails are printed to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AI101 Talents <no-reply@ai101talents.com>"
# Optional address for admin notifications (defaults to all admin accounts).
ADMIN_NOTIFY_EMAIL=
# Public contact address shown in email footers.
CONTACT_EMAIL=hello@ai101talents.com

# ---- Data retention (node-cron) ------------------------------------------------
# Deletes candidate profiles inactive longer than the period set in Admin → Settings (default 24 months).
# When running several server instances, enable it on exactly one of them.
RETENTION_ENABLED=true
# Cron expression, evaluated in UTC (default: every day at 03:00).
RETENTION_CRON=0 3 * * *

# ---- Single-service deployment -------------------------------------------------
# true = this server also serves the built web app (client/dist) with a strict Content-Security-Policy.
# Set CLIENT_URL to the public URL of this server in that case.
SERVE_CLIENT=false

# ---- File storage (CVs, cover letters) ----------------------------------------
# Files are private: they are only served through short-lived signed URLs.
# local = server disk (development; fine for a single persistent server)
# s3    = any S3-compatible service: AWS S3, Cloudflare R2, MinIO… (recommended in production)
STORAGE_DRIVER=local
# Folder for the local driver, relative to server/ (gitignored).
STORAGE_LOCAL_DIR=uploads
# Lifetime of signed download links, in seconds (30–3600).
STORAGE_SIGNED_URL_TTL=300
# Required when STORAGE_DRIVER=s3. Keep the bucket private (no public access).
STORAGE_S3_BUCKET=
# AWS region, or "auto" for Cloudflare R2.
STORAGE_S3_REGION=auto
# Leave empty for AWS. For R2: https://<account-id>.r2.cloudflarestorage.com
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY_ID=
STORAGE_S3_SECRET_ACCESS_KEY=
# Public base URL of this API, used in signed links for the local driver.
# Leave empty when the client proxies /api (development) or serves the API on the same origin.
API_PUBLIC_URL=

# ---- Seed script (npm run seed -w server) -----------------------------------
# Logins created by the seed. Development data only — change them for any shared environment.
SEED_ADMIN_EMAIL=admin@ai101talents.example
SEED_ADMIN_PASSWORD=Admin12345!
SEED_DEMO_PASSWORD=Password123!
